// Esquema de datos de la app de pesca (provincia de Sevilla).
//
// Portabilidad SQLite -> PostgreSQL:
//   - No se usan `enum` de Prisma (SQLite no los soporta). Los campos de tipo
//     enumerado son `String` y sus valores válidos viven en `src/lib/enums.ts`,
//     que es la fuente de verdad para TypeScript.
//   - No se usan arrays escalares (tampoco soportados en SQLite). `mejorEpoca`
//     se guarda como JSON de números de mes en un `String`.
//   - No se usan tipos nativos ni funciones específicas de un motor.
// Para migrar basta con cambiar `provider` a "postgresql" y regenerar migraciones.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Usuarios
// ---------------------------------------------------------------------------

model Usuario {
  id           String  @id @default(cuid())
  nombre       String
  email        String  @unique
  passwordHash String
  avatarUrl    String?

  /// RolUsuario: usuario | admin. Los admin pueden borrar capturas ajenas,
  /// que en una web con registro abierto hace falta para poder moderar.
  rol String @default("usuario")

  capturas Captura[]
  salidas  Salida[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Provincias
// ---------------------------------------------------------------------------

/**
 * Cada provincia es una landing propia (/sevilla, /huelva...) con sus sitios,
 * su ranking y su normativa.
 *
 * `publicada` existe para no llenar Google de páginas vacías: una provincia sin
 * sus sitios y sin su normativa verificada no sale a ninguna parte. Google
 * penaliza las páginas puente, y en una web de pesca publicar normativa sin
 * contrastar puede costarle una multa a alguien.
 */
model Provincia {
  id     String @id @default(cuid())
  slug   String @unique
  nombre String

  comunidad String

  /// Centro aproximado, para encuadrar el mapa de la provincia.
  latitud  Float
  longitud Float

  /// Texto de la landing. Es el contenido propio que la hace valer para Google.
  descripcion String @default("")

  /// Aguas donde SÍ se pueden pescar las especies exóticas invasoras. Cambia
  /// de una provincia a otra, así que va aquí y no en un texto compartido.
  areasDelimitadasEEI String @default("")

  /// Normativa propia de la provincia y enlace al boletín donde se comprueba.
  notasLegales    String  @default("")
  urlOrdenDeVedas String?

  /// Solo se publica lo que tiene sitios cargados y normativa verificada.
  publicada Boolean @default(false)

  sitios    Sitio[]
  articulos Articulo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicada])
}

// ---------------------------------------------------------------------------
// Guía de sitios
// ---------------------------------------------------------------------------

model Sitio {
  id     String @id @default(cuid())
  slug   String @unique
  nombre String

  /// TipoSitio: embalse | rio | canal
  tipo      String
  municipio String

  provinciaId String
  provincia   Provincia @relation(fields: [provinciaId], references: [id])

  latitud  Float
  longitud Float

  descripcion String

  /// Capacidad del embalse en hm³ (null en ríos y canales).
  capacidadHm3 Float?

  accesoDescripcion String
  /// DificultadAcceso: facil | media | dificil
  dificultadAcceso String

  tieneSombra Boolean @default(false)
  navegable   Boolean @default(false)

  /// Referencia de cercanía desde la capital de la provincia. En Sevilla se
  /// dejó medida desde Dos Hermanas, que es de donde salimos.
  distanciaDesdeDosHermanasKm Float
  tiempoCocheMin              Int

  /// true si el sitio está en el listado de aguas donde SÍ se pueden pescar
  /// las especies exóticas invasoras (black bass, lucio, carpa, trucha arcoíris).
  esAreaDelimitadaEEI Boolean @default(false)

  /// Si alguien ha mirado de verdad la orden de vedas para este sitio.
  ///
  /// Sin esto, un sitio recién cargado sale con `esAreaDelimitadaEEI` en false,
  /// que no significa «no está en el listado»: significa «nadie lo ha mirado».
  /// Y esas dos cosas dicen lo contrario a quien tiene un black bass en la
  /// mano —devolverlo o sacrificarlo—, así que el «no lo sé» tiene que poder
  /// escribirse. Mientras esté en false la web dice que no lo sabe, y la
  /// provincia no se puede publicar.
  eeiComprobado Boolean @default(false)

  notasLegales     String @default("")
  avisosSanitarios String @default("")

  /// JSON con los números de mes (1-12) de la mejor época. Ej: "[3,4,5,10]".
  mejorEpoca String @default("[]")

  /// Ficha en embalses.net u otra fuente para consultar el nivel del agua.
  urlNivelAgua String?

  /// --- Nivel del agua, del boletín hidrológico ---
  ///
  /// Cuánta agua lleva ahora mismo el embalse. Cambia por completo dónde se
  /// pesca: a media capacidad quedan orillas enteras al descubierto y los
  /// puestos de siempre se van a diez metros del agua.
  ///
  /// El dato oficial es SEMANAL, no en tiempo real. Por eso viaja siempre con
  /// su fecha: un porcentaje sin fecha, en agosto y bajando, miente.
  nivelHm3        Float?
  nivelPorcentaje Float?
  nivelFecha      DateTime?
  /// De dónde salió, para poder citarlo en la ficha.
  nivelFuente String?
  /// Nombre del embalse en el boletín, que no coincide con el nuestro.
  /// «Embalse José Torán» allí es «JOSE TORAN». Se guarda una vez comprobado
  /// para no depender de adivinarlo en cada actualización.
  nombreEnBoletin String?

  /// Foto de cabecera. La baja `npm run fotos` de Wikimedia Commons, donde
  /// casi todos los embalses y ríos españoles tienen fotos libres.
  imagenUrl String?
  /// Autoría y licencia de la foto. Si viene de Commons hay obligación de
  /// atribuirla, así que viaja con ella y se pinta donde se muestre.
  imagenAutor    String?
  imagenLicencia String?
  imagenFuente   String?

  especies SitioEspecie[]
  aparejos AparejoSitio[]
  capturas Captura[]
  salidas  Salida[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo])
  @@index([municipio])
  @@index([provinciaId])
}

// ---------------------------------------------------------------------------
// Guía de especies
// ---------------------------------------------------------------------------

model Especie {
  id               String @id @default(cuid())
  slug             String @unique
  nombreComun      String
  nombreCientifico String

  esAutoctona Boolean @default(false)

  /// EstadoLegal: pescable | devolucion_obligatoria | prohibida |
  ///              invasora_area_delimitada | invasora_no_pescable
  estadoLegal String

  /// Talla mínima legal en cm (null si no aplica).
  tallaMinimaCm Int?

  /// Comestible: si | no | desaconsejado
  comestible          String
  notasComestibilidad String @default("")
  notasLegales        String @default("")

  imagenUrl   String?
  /// Autoría y licencia de la imagen. Si la foto viene de Wikimedia Commons hay
  /// obligación de atribuirla, así que se guarda con ella y se pinta en la ficha.
  imagenAutor    String?
  imagenLicencia String?
  imagenFuente   String?

  descripcion String

  /// Cómo y dónde buscarla (bloque libre para la ficha de especie).
  comoPescarla String @default("")

  sitios    SitioEspecie[]
  aparejos  AparejoEspecie[]
  capturas  Captura[]
  articulos Articulo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estadoLegal])
}

/// Qué especies hay en qué sitio y con qué probabilidad. Es el corazón de la guía.
model SitioEspecie {
  sitioId   String
  especieId String

  sitio   Sitio   @relation(fields: [sitioId], references: [id], onDelete: Cascade)
  especie Especie @relation(fields: [especieId], references: [id], onDelete: Cascade)

  /// 1 (rara) a 5 (muy abundante)
  abundancia Int

  /// Probabilidad: alta | media | baja
  probabilidadCaptura String

  notas        String @default("")
  mejorTecnica String @default("")

  @@id([sitioId, especieId])
  @@index([especieId])
}

// ---------------------------------------------------------------------------
// Técnicas y aparejos
// ---------------------------------------------------------------------------

model Tecnica {
  id          String @id @default(cuid())
  slug        String @unique
  /// spinning | fondo | superficie | feeder
  nombre      String
  descripcion String

  capturas Captura[]
}

model Aparejo {
  id     String @id @default(cuid())
  slug   String @unique
  nombre String

  /// TipoAparejo: vinilo | senuelo_duro | cebo_natural | engodo | montaje
  tipo String

  descripcion    String
  precioAproxEur Float?
  imagenUrl      String?

  especies AparejoEspecie[]
  sitios   AparejoSitio[]
  capturas Captura[]

  @@index([tipo])
}

model AparejoEspecie {
  aparejoId String
  especieId String

  aparejo Aparejo @relation(fields: [aparejoId], references: [id], onDelete: Cascade)
  especie Especie @relation(fields: [especieId], references: [id], onDelete: Cascade)

  /// 1 (funciona a veces) a 5 (el mejor)
  efectividad Int
  notas       String @default("")

  @@id([aparejoId, especieId])
  @@index([especieId])
}

model AparejoSitio {
  aparejoId String
  sitioId   String

  aparejo Aparejo @relation(fields: [aparejoId], references: [id], onDelete: Cascade)
  sitio   Sitio   @relation(fields: [sitioId], references: [id], onDelete: Cascade)

  recomendado Boolean @default(true)
  notas       String  @default("")

  @@id([aparejoId, sitioId])
  @@index([sitioId])
}

// ---------------------------------------------------------------------------
// Diario: salidas y capturas
// ---------------------------------------------------------------------------

/// Una jornada de pesca. Agrupa las capturas de ese día en ese sitio.
model Salida {
  id        String @id @default(cuid())
  usuarioId String
  sitioId   String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sitio   Sitio   @relation(fields: [sitioId], references: [id])

  fecha DateTime
  /// "HH:MM" hora local.
  horaInicio String?
  horaFin    String?

  notas String @default("")
  /// 1 a 5
  valoracion Int?

  capturas Captura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId, fecha])
  @@index([sitioId])
}

model Captura {
  id        String  @id @default(cuid())
  usuarioId String
  sitioId   String
  especieId String
  salidaId  String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sitio   Sitio   @relation(fields: [sitioId], references: [id])
  especie Especie @relation(fields: [especieId], references: [id])
  salida  Salida? @relation(fields: [salidaId], references: [id], onDelete: SetNull)

  fecha DateTime
  /// "HH:MM" hora local.
  hora String

  pesoGramos Int?
  longitudCm Float?

  aparejoId String?
  tecnicaId String?
  aparejo   Aparejo? @relation(fields: [aparejoId], references: [id], onDelete: SetNull)
  tecnica   Tecnica? @relation(fields: [tecnicaId], references: [id], onDelete: SetNull)

  /// Punto exacto tomado del GPS del móvil (puede faltar si no hubo señal).
  latitud  Float?
  longitud Float?

  fotos FotoCaptura[]

  liberado Boolean @default(true)

  temperaturaC     Float?
  condicionesMeteo String?
  nivelAgua        String?

  notas String @default("")

  /// Identificador que genera el cliente offline para evitar duplicados al sincronizar.
  clienteUuid String? @unique

  /// Captura de muestra, para que el diario y el ranking no se vean vacíos
  /// mientras no haya capturas de verdad. Se marca en toda la interfaz y se
  /// excluye de los cálculos que corrigen las abundancias de la guía: si una
  /// captura inventada moviera esos números, la guía dejaría de ser fiable.
  /// Se borran con SEMBRAR_DEMO=no.
  esEjemplo Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Momento en que la captura llegó al servidor desde el diario offline.
  syncedAt DateTime?

  @@index([usuarioId, fecha])
  @@index([especieId])
  @@index([sitioId])
  @@index([salidaId])
}

model FotoCaptura {
  id        String  @id @default(cuid())
  capturaId String
  captura   Captura @relation(fields: [capturaId], references: [id], onDelete: Cascade)

  url         String
  esPrincipal Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([capturaId])
}

/// Artículo del blog.
///
/// El blog existe por posicionamiento: la guía responde a «dónde pescar en
/// Sevilla», pero la mayoría de las búsquedas de pesca son preguntas —«hace
/// falta licencia», «qué hago si pesco un lucio», «cuándo se pesca la carpa»—
/// y a esas no responde una ficha de embalse. Cada artículo entra por su
/// pregunta y lleva a la guía.
model Articulo {
  id     String @id @default(cuid())
  slug   String @unique
  titulo String
  /// Resumen de una o dos frases. Es lo que sale en el listado y en Google.
  entradilla String
  /// Cuerpo en Markdown reducido: ##, ###, listas, **negrita**, [enlaces] y
  /// citas. Se convierte a elementos de React, nunca a HTML en crudo.
  contenido String

  /// Sin publicar no se ve ni entra en el sitemap, igual que las provincias.
  publicada    Boolean   @default(false)
  publicadaEl  DateTime?

  /// Para poder decir «Guía de Sevilla» en un artículo de provincia y para
  /// enlazarlos entre sí. Opcional: los hay que valen para toda España.
  provinciaId String?
  provincia   Provincia? @relation(fields: [provinciaId], references: [id], onDelete: SetNull)

  /// De qué especie va, si va de una.
  ///
  /// Sirve para que la ficha de la especie enlace a sus artículos. Hasta ahora
  /// los enlaces iban en un solo sentido —el artículo enlazaba a la ficha,
  /// nunca al revés—, así que la página que recibe las visitas de Google era
  /// un callejón sin salida y no repartía nada a lo demás.
  especieId String?
  especie   Especie? @relation(fields: [especieId], references: [id], onDelete: SetNull)

  imagenUrl      String?
  imagenAutor    String?
  imagenLicencia String?
  imagenFuente   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicada, publicadaEl])
}
