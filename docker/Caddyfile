# Caddy pide y renueva el certificado solo. No hay que tocar nada más.

# El www va al dominio a secas, que es el que apuntan las canónicas y el
# sitemap. Sin esto, quien escriba www.midominio.es se encuentra un error, y
# si además llegara a servirse el mismo contenido en las dos direcciones Google
# lo trataría como dos webs repartiéndose la fuerza.
#
# Necesita su propio registro A en el DNS: si no existe, la web principal
# funciona igual pero Caddy se queda reintentando el certificado del www y lo
# deja escrito en el registro.
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# La analítica, en su propio subdominio y con su propio certificado.
#
# Necesita un registro A en el DNS apuntando a este servidor, igual que el
# www. Sin él, Caddy se queda reintentando el certificado y la web principal
# sigue funcionando: no se lleva nada por delante.
#
# El panel queda expuesto a internet, así que lo único que lo protege es la
# contraseña de Umami. Cámbiala nada más entrar: viene con admin/umami.
{$DOMINIO_ANALITICA} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
		# Que no acabe en Google el panel de estadísticas.
		X-Robots-Tag "noindex, nofollow"
	}

	reverse_proxy umami:3000
}

{$DOMINIO} {
	encode zstd gzip

	# Las imágenes llevan nombre aleatorio y no se reescriben nunca, así que se
	# pueden cachear para siempre. Van detrás de la app, no de Caddy, porque la
	# app decide quién puede verlas.
	@media path /media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	header {
		# Cabeceras de seguridad básicas.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy app:3000
}
