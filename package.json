{
  "name": "mapa-de-pesca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "dev:movil": "next dev -H 0.0.0.0",
    "fotos": "tsx scripts/fotos.mjs",
    "predev": "prisma migrate deploy",
    "actualizar": "npm run db:deploy && npm run db:seed",
    "contrasena": "tsx scripts/contrasena.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "niveles": "tsx scripts/niveles.ts",
    "admin": "tsx scripts/admin.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "fflate": "^0.8.3",
    "mdb-reader": "^3.2.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
