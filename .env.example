# Base de datos. La ruta es relativa a la raíz del proyecto.
DATABASE_URL="file:./prisma/dev.db"

# Contraseña inicial que el seed asigna a los dos usuarios.
SEED_PASSWORD="pesca2026"

# Firma de las cookies de sesión. Genera uno propio para el VPS con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambia-esto-por-un-secreto-de-32-bytes-en-base64"

# Dominio público, con esquema y sin barra final. De aquí salen las URLs
# absolutas del sitemap, las canónicas y las tarjetas al compartir enlaces.
# En desarrollo apunta a localhost; en el VPS, a tu dominio con https.
URL_BASE="http://localhost:3000"

# Identificador de Google AdSense (ca-pub-XXXXXXXXXXXXXXXX).
# Mientras esté vacío no hay anuncios, no sale el banner de cookies y no se
# carga nada de Google. En cuanto se rellena, aparece el banner y el script
# solo se envía al navegador si el visitante acepta.
ADSENSE_ID=""

# Quien responde de la web, para el aviso legal. La LSSI obliga a identificar
# al prestador del servicio y el RGPD a decir a quién se le reclaman los datos
# y cómo. Mientras estén vacíos, /aviso-legal lo dice abiertamente en vez de
# fingir que están.
#
# Van aquí y no en el código a propósito: son datos personales y no tienen por
# qué estar en un repositorio.
RESPONSABLE_NOMBRE=""
RESPONSABLE_CONTACTO=""

# --- Analítica -------------------------------------------------------------
#
# Contador de visitas propio (Umami), en un subdominio del mismo servidor.
# Mientras estén vacías no se envía ningún script al navegador: ese es el
# estado normal en desarrollo, y es lo que impide que trastear en local le meta
# visitas inventadas a las estadísticas de verdad.
#
# UMAMI_WEBSITE_ID sale del panel al dar de alta la web (Settings → Websites).
UMAMI_URL=""
UMAMI_WEBSITE_ID=""

# Solo en el VPS: las usa docker-compose para levantar Umami y su base de
# datos. Genera las dos, distintas, con:
#   openssl rand -hex 32
#
# En hexadecimal y no en base64 por dos razones: openssl está en cualquier
# servidor y node no —solo vive dentro del contenedor—, y la contraseña de la
# base de datos va metida en una dirección «postgresql://umami:LACLAVE@...»,
# donde una barra o un símbolo de suma la parten por la mitad.
UMAMI_DB_PASSWORD=""
UMAMI_APP_SECRET=""

# El subdominio del panel. Por defecto, analitica.TUDOMINIO.
DOMINIO_ANALITICA=""
